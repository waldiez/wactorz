# Build a Wactorz AppImage on Ubuntu 22.04 (glibc 2.35) so it runs on the widest
# range of Linux hosts (not just bleeding-edge distros). Same image for both
# arches — pick with --platform; build-appimage.sh names the output per uname -m.
#
# aarch64 (Apple Silicon = native; x86 host needs qemu/binfmt):
#   docker build --platform=linux/arm64 -t wactorz-appimage:arm64 -f packaging/linux/Dockerfile.appimage .
#   rm -rf .local/build-venv            # stale non-Linux venv would break reuse
#   docker run --rm --platform=linux/arm64 -v "$PWD:/src" -w /src wactorz-appimage:arm64 \
#       bash packaging/linux/build-appimage.sh        # -> ./dist/Wactorz-aarch64.AppImage
#
# x86_64 (x86 host = native; Apple Silicon needs emulation, slower):
#   docker build --platform=linux/amd64 -t wactorz-appimage:amd64 -f packaging/linux/Dockerfile.appimage .
#   rm -rf .local/build-venv
#   docker run --rm --platform=linux/amd64 -v "$PWD:/src" -w /src wactorz-appimage:amd64 \
#       bash packaging/linux/build-appimage.sh        # -> ./dist/Wactorz-x86_64.AppImage
#
# Cross-arch one-time (enables qemu/binfmt): docker run --privileged --rm tonistiigi/binfmt --install all
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip python3-dev build-essential \
      git wget ca-certificates file desktop-file-utils squashfs-tools \
      libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libatspi2.0-0 \
      libcups2 libdrm2 libgbm1 libasound2 libglib2.0-0 libgtk-3-0 \
      libpango-1.0-0 libpangocairo-1.0-0 libcairo2 libfontconfig1 libfreetype6 \
      libegl1 libgl1 libglx-mesa0 \
      libx11-6 libx11-xcb1 libxext6 libxfixes3 libxdamage1 libxcomposite1 \
      libxrandr2 libxi6 libxtst6 libxcb1 libxcb-render0 libxcb-shm0 \
      libxcb-cursor0 libxkbcommon0 libxkbcommon-x11-0 libxshmfence1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
