{
  "name": "wactorz-dashboard",
  "version": "0.6.1",
  "description": "Wactorz dashboard",
  "private": true,
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "bun run typecheck && bun run prettier:check && bun run eslint:check && bun run markdownlint:check",
    "typecheck": "tsc --noEmit",
    "eslint:check": "eslint --config ./eslint.config.mjs --report-unused-disable-directives --max-warnings 0 --no-warn-ignored --cache .",
    "eslint": "eslint --config ./eslint.config.mjs --fix --cache .",
    "prettier:check": "prettier \"src/**/*{.ts,.tsx,.css,.json}\" \"public/**/*.js\" \"*.{ts,mjs}\" --check",
    "prettier": "prettier \"src/**/*{.ts,.tsx,.css,.json}\" \"public/**/*.js\" \"*.{ts,mjs}\" --write --list-different",
    "markdownlint:check": "markdownlint-cli2 \"*.md\"",
    "markdownlint": "markdownlint-cli2 --fix \"*.md\"",
    "fmt": "bun run prettier",
    "format": "bun run fmt",
    "docs": "typedoc",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-headers": "^1.3.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "happy-dom": "^20.14.5",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
