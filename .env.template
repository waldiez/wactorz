# ─────────────────────────────────────────────────────────────────────────────
#  Wactorz — environment template
#  Copy to .env and fill in your values:  cp .env.template .env
# ─────────────────────────────────────────────────────────────────────────────


# ── General ───────────────────────────────────────────────────────────────────
# Time zone. Useful for logs and cron jobs
TZ=UTC
# Optional: timezone for agents' date/time awareness (use IANA names like
# Europe/Athens, not POSIX offsets).
# WACTORZ_TZ=Europe/Athens

# Where durable state lives (SQLite database, per-agent pickles, MQTT outbox).
# Relative to the working directory unless you set an absolute path — do set one
# if that directory isn't durable, e.g. a container without a mounted volume.
# WACTORZ_STATE_DIR=/var/lib/wactorz/state

# Which network interface the dashboard, the REST API and the WhatsApp webhook
# listen on. The default serves every interface, so on a shared network anyone
# who can reach the machine can reach all three. Set 127.0.0.1 to serve only this
# machine — but not inside a container, where a published port cannot reach a
# process bound to the container's own loopback.
# WACTORZ_BIND_HOST=127.0.0.1

# Extra browser origins allowed to call the API and open the WebSocket. The page
# this server serves is always allowed, so this is only for a dashboard hosted
# somewhere else. Comma-separated, e.g. https://dash.example.com
# Requests from anywhere else are refused if they would change something, and
# their responses are not readable by the calling page.
# WACTORZ_CORS_ORIGINS=

# Extra host names this server answers to. Loopback names and IP addresses are
# always accepted, so reaching it at localhost or 192.168.1.5 needs nothing here.
# A name that is neither is refused even though it resolves here — that is what a
# DNS rebinding attack looks like. Set this to reach the dashboard by an mDNS or
# LAN name, e.g. wactorz.local
# WACTORZ_ALLOWED_HOSTS=

# Whether files may be attached to chat messages. On by default. Set it to 0 to
# turn attachments off entirely: the endpoint writes uploaded bytes to disk under
# <WACTORZ_STATE_DIR>/uploads and nothing prunes them yet, which not every install
# wants growing there. The dashboard asks the server which way this is set, so
# turning it off also removes the drop zone rather than leaving one that fails.
# ⚠ Like every route, it is not authenticated yet — an install reachable beyond
# its own network is offering an open write endpoint while this is on.
# WACTORZ_UPLOADS=0

# Largest single attachment, in bytes. Matches the limit the browser applies
# before sending, so a file the interface accepts is not refused on arrival.
# WACTORZ_UPLOAD_MAX_BYTES=26214400

# Which speech-to-text branch this deployment offers: off, browser, server or
# host. Off by default, and the dashboard shows no microphone until it is set.
#   server   the browser captures, this host transcribes -- the branch to set
#   browser  the client captures and transcribes, sending only text
#   host     this host captures from its own microphone and transcribes
# `browser` uses the recogniser the browser itself carries, so no audio reaches
# this deployment. That is not the same as the audio staying on the machine:
# Chrome sends it to Google and Safari to Apple, and the page is not told which.
# A deployment that must keep speech inside its own network wants `server` with
# a self-hosted recogniser instead. Only Chromium implements it, and only where
# the page is trusted with a microphone -- localhost or TLS -- so the button is
# offered exactly there and nowhere else.
#
# `host` has no button, because nobody is necessarily at a screen: something has
# to ask it to listen, by POSTing to /api/stt/listen. What it hears is routed as
# though typed -- an @mention reaches the agent it names, anything else reaches
# main -- and both the question and the answer are written to the chat log and
# shown to any browser that is open. Needs a microphone on this machine:
#   pip install 'wactorz[host]'
# It will not listen while this machine is speaking, so a room with WACTORZ_TTS
# also set to host does not hear its own reply and answer it.
# Browser capture needs a secure context (HTTPS or localhost), so a plain-HTTP
# LAN install gets no microphone in browser or server mode however it is set
# here. Host mode is the one that works there, and it is also the one where the
# server hears the room rather than only what a user chose to send.
# WACTORZ_STT=server

# Where the speech recogniser listens, for the server and host branches. The
# scheme chooses what kind it is, and nothing else needs saying:
#
#   tcp://  a Wyoming service. It transcribes a whole recording once you stop
#           speaking. Widest reach, no GPU, and the default -- a Whisper service
#           on this host, which is what the Home Assistant add-on provides.
#           Needs the extra: pip install 'wactorz[stt]'
#   ws://   a sherpa-onnx streaming server. Words appear in the composer while
#           you are still talking, and correct themselves as it hears more.
#           Needs nothing beyond what is already installed. See infra/voice/stt/
#           for one you can run.
#
# Either can sit on another machine entirely: both are network protocols, so
# point this at it and nothing else changes.
# WACTORZ_STT_URI=tcp://localhost:10300
# WACTORZ_STT_URI=ws://localhost:6006

# Set only by the Home Assistant add-on, which sits behind an ingress proxy that
# signs the user in before forwarding. It lets such a request skip the origin and
# host checks above. Leave this unset anywhere else: without it the bypass does not
# exist at all, whatever headers arrive.
# WACTORZ_INGRESS=1

# Addresses the Home Assistant ingress bypass is accepted from, as comma-separated
# CIDRs. Only relevant to the add-on: a request Home Assistant proxies skips the
# origin and host checks above, because Home Assistant has already signed the user
# in. The header marking such a request can be set by anything on the container
# network, so it is only honoured from the proxy's own address. Change this only if
# your Home Assistant proxies from somewhere else — the add-on log names the address
# it accepted, and names the one it refused if this is wrong.
# WACTORZ_INGRESS_PEERS=172.30.32.0/23

# Interface the Python app exposes.
# Options: rest | cli | discord | telegram | whatsapp
INTERFACE=rest

# REST API port
PORT=8000

# Monitor / Web UI port
MONITOR_PORT=8888


# ── LLM provider ─────────────────────────────────────────────────────────────

# Options: anthropic | openai | ollama | nim | gemini | none | fake
#   none = no provider at all; fake = deterministic canned replies, calls nothing
LLM_PROVIDER=anthropic

# Model ID — examples per provider:
#   anthropic → claude-sonnet-4-6
#   openai    → gpt-4o
#   ollama    → llama3
#   nim       → meta/llama-3.3-70b-instruct
#   gemini    → gemini-2.5-flash
LLM_MODEL=claude-sonnet-4-6

# Generic key — used for anthropic/openai/nim/gemini.
# Or set the provider-specific key below.
LLM_API_KEY=

# Set LLM stochasticity with temperature, 0 is the default.
# Claude models from Opus 4.7 onward no longer accept it, and ignore this.
LLM_TEMPERATURE=0

# Optional spend cap. Set to 0 to disable.
# Period options: daily, weekly, monthly (default). Resets automatically each period.
# Note: if set here, the GUI can override at runtime via Settings. GUI value takes priority.
LLM_COST_LIMIT_USD=0
LLM_COST_LIMIT_PERIOD=monthly

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: use this if you want to use an OpenAI-compatible provider (Groq, Together, vLLM, llama.cpp, etc.)
OPENAI_URL=
GEMINI_API_KEY=
NIM_API_KEY=
NVIDIA_API_KEY=

# Ollama base URL (only needed when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434


# ── MQTT broker ───────────────────────────────────────────────────────────────

MQTT_HOST=localhost #host.docker.internal
MQTT_PORT=1883

# Broker credentials. REQUIRED for docker compose: the bundled broker no longer
# accepts anonymous connections, and compose refuses to start without a password
# rather than coming up open. The broker's password file is generated from these
# at container start, so there is no mosquitto_passwd step to run.
#
# Why it is not optional: the broker is the control plane. Agent commands, chat,
# and the code spawned agents run all cross it, and port 1883 is published to
# the host — so an anonymous broker is publish access to all of that from
# anywhere that can reach the port.
#
# Pointing at a broker you run yourself? Leave them blank if it takes anonymous
# connections. The compose file is what requires them.
MQTT_USERNAME=wactorz
MQTT_PASSWORD=

# Host-side port mappings for docker compose
MQTT_EXTERNAL_PORT=1883


# ── Docker compose external ports ─────────────────────────────────────────────

# Python stack
REST_EXTERNAL_PORT=8000
MONITOR_EXTERNAL_PORT=8888


# ── API security ──────────────────────────────────────────────────────────────

# Optional API key for the REST API. Clients send it as X-API-Key.
API_KEY=

# Optional MCP server bridge. WACTORZ_API_KEY should match API_KEY when REST auth is enabled.
WACTORZ_URL=http://localhost:8000
WACTORZ_API_KEY=


# ── Home Assistant integration ────────────────────────────────────────────────

# Long-lived access token: HA → Profile → Long-lived access tokens
HA_URL=http://192.168.1.2:8123
HA_TOKEN=

# State-bridge: which entity domains to forward over MQTT.
# Leave blank to forward everything. Example: light,switch,sensor,binary_sensor
HA_STATE_BRIDGE_DOMAINS=

# Base MQTT topic for HA state-change events
HA_STATE_BRIDGE_OUTPUT_TOPIC=homeassistant/state_changes

# 1 = publish each entity to its own sub-topic ({base}/{domain}/{entity_id})
# 0 = send all events to the single base topic
HA_STATE_BRIDGE_PER_ENTITY=0

# Advanced — leave blank for defaults
HA_MAP_AGENT_OUTPUT_TOPIC=
HA_MAP_AGENT_TARGET_ACTOR=

# ── Remote edge nodes (SSH deploy targets) ────────────────────────────────────
#
# `/deploy <name>` bootstraps a remote machine (Raspberry Pi, VM, edge device)
# by uploading remote_runner.py over SSH. The machines it may connect to are
# listed here, and the credentials live here too — never pass them in chat. Chat
# messages are persisted to the conversation history and the chat log, so a
# password typed into `/deploy` stays on disk long after the deploy finished.
#
# List the node names in DEPLOY_TARGETS, then add a block per node. The block is
# keyed by the node name upper-cased with every run of non-alphanumerics turned
# into one underscore: `rpi-kitchen` → DEPLOY_RPI_KITCHEN_*.
#
# A node name becomes one level of an MQTT topic (nodes/<name>/heartbeat), so it
# cannot contain `#`, `+` or `/`. Watch the comment rule here: `#` only starts a
# comment when a space precedes it, so `DEPLOY_TARGETS=rpi-kitchen#,rpi-garage`
# defines a node literally named `rpi-kitchen#`. Deploy refuses such a name
# rather than starting a runner the broker will reject.
#
# DEPLOY_TARGETS=rpi-kitchen,rpi-garage
#
# DEPLOY_RPI_KITCHEN_HOST=192.168.1.50     # omit to resolve <name>.local via mDNS
# DEPLOY_RPI_KITCHEN_USER=pi               # default: pi
# DEPLOY_RPI_KITCHEN_KEY=/path/to/id_ed25519   # preferred over a password
# DEPLOY_RPI_KITCHEN_PASSWORD=             # only if the node has no key auth
# DEPLOY_RPI_KITCHEN_BROKER=192.168.1.10   # broker address as seen FROM the Pi
# DEPLOY_RPI_KITCHEN_BROKER_PORT=1883
# DEPLOY_RPI_KITCHEN_SSH_PORT=22
# DEPLOY_RPI_KITCHEN_BROKER_USER=          # default: this server's MQTT_USERNAME
# DEPLOY_RPI_KITCHEN_BROKER_PASSWORD=      # default: this server's MQTT_PASSWORD
#
# The broker credentials are written to ~/wactorz/.env on the node (mode 0600)
# during /deploy and sourced when the runner starts, so they never appear in a
# command line. Defaulting to this server's own is the usable choice for one
# broker with one account — but it does mean a stolen node holds full broker
# access, and the broker carries the code spawned agents run. Give a node its
# own account when that matters; a password file holds as many users as needed.
#
# DEPLOY_RPI_GARAGE_HOST=192.168.1.51
# DEPLOY_RPI_GARAGE_KEY=/path/to/id_ed25519
# DEPLOY_RPI_GARAGE_BROKER=192.168.1.10

# SSH host keys are verified. A machine that has never been connected to has its
# key recorded on first contact (as `ssh` does interactively); after that, a
# changed key fails the connection instead of being accepted silently.
# Where the learned keys are stored. Default: <WACTORZ_STATE_DIR>/known_hosts
# DEPLOY_KNOWN_HOSTS=

# 1 = never learn a key automatically. Every target's key must already be in the
# file above (`ssh-keyscan <host> >> <file>` after verifying the fingerprint),
# and an unknown host is refused rather than trusted on first contact.
DEPLOY_STRICT_HOST_KEYS=0

# ── Prometheus ───────────────────────────────────────────────────────────────
PROMETHEUS_EXTERNAL_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s
# What Prometheus should scrape for Python metrics.
#   - If Wactorz runs in docker compose, leave the default service name.
#   - If Wactorz runs from the terminal, use host.docker.internal
PROMETHEUS_PYTHON_TARGET=wactorz-python
# Probe Mosquitto via the Blackbox Exporter (TCP connect to mosquitto:1883)
PROMETHEUS_MONITOR_MOSQUITTO=0

# ── Server TTS (optional) ────────────────────────────────────────────────────
# How this deployment speaks, if it does: off, browser, server or host.
#
#   off      nothing is read aloud, and the browser does not stand in for it.
#   browser  the browser's own voice. The words stay on this machine, which is
#            the only way to have speech without handing text to a synthesiser.
#   server   made here (or by WACTORZ_TTS_URI below) and played in the browser.
#            The default when unset.
#   host     made here and played through this machine's own speakers, so it
#            answers into a room rather than a page. Only replies to a turn
#            someone started are read aloud -- agents talking among themselves
#            stay quiet. Needs speakers: pip install 'wactorz[host]', which also
#            carries what it takes to play the built-in voice.
# WACTORZ_TTS=server

# Where speech is made. Unset, it is made here by edge-tts:
#   pip install 'wactorz[tts]'
# Set, it is made by the service named. The scheme chooses the kind, as it does
# for recognition, and says what has to be installed to speak to it:
#
#   tcp://   a Wyoming synthesiser -- wyoming-piper and anything else speaking
#            the protocol. Self-hosted, so the words never leave the network.
#            Needs the extra: pip install 'wactorz[tts]'
#   http://  an endpoint that takes text and answers with audio, which is the
#   https:// shape most hosted services already have. The request carries the
#            text as both `input` and `text`, and the voice as `voice`, which
#            covers the common shapes. Anything a service needs beyond those --
#            a model name, an API key -- has to come from something in front of
#            it, so a service demanding one wants a small proxy here.
#
# The browser plays whatever comes back and never learns this address.
# WACTORZ_TTS_URI=tcp://localhost:10200
# WACTORZ_TTS_URI=https://voice.example/v1/audio/speech

# Leave TTS_VOICE empty for the default (en-US-JennyNeural).
# Run GET /api/tts/voices for the full list. A named service brings its own
# voices and answers that list with nothing, so set this to a name it knows.
TTS_VOICE=

# ── Catalogue agents ─────────────────────────────────────────────────────────
#
# smart-energy (catalog agent: spawn via "spawn the smart energy agent")
#   Electricity rate used for cost estimates. Can also be changed at runtime
#   by telling the agent "set rate to 0.25". Override here to set the default
#   for all users on this deployment.
ENERGY_RATE=0.138
ENERGY_CURRENCY=EUR

# reachy-mini (catalog agent: "@catalog spawn reachy-mini")
#   To drive the robot WITHOUT the Reachy Mini control app (connect straight to
#   the powered-on robot over WiFi), set both of these and restart the agent:
#     REACHY_CONNECTION_MODE=network   — skip the localhost/control-app probe
#     REACHY_ROBOT_HOST=<ip|host>      — the robot's address (avoids flaky mDNS),
#                                        e.g. 192.168.1.42 or reachy-mini.local
#   Leave blank for auto-detect (localhost/control-app first, then the robot).
#   REACHY_MEDIA_BACKEND=webrtc routes speech to the ROBOT speaker (else this host).
REACHY_CONNECTION_MODE=
REACHY_ROBOT_HOST=
REACHY_MEDIA_BACKEND=

# Push-to-talk STT for `@reachy-mini listen and ask Wactorz` / cmd=ask_voice.
# Default is local faster-whisper. Hosted OpenAI is explicit opt-in and also needs
# OPENAI_API_KEY above; never put a key directly in the Reachy recipe.
REACHY_STT_BACKEND=faster-whisper
REACHY_STT_MODEL=base
REACHY_STT_LANGUAGE=
REACHY_STT_DEVICE=auto
REACHY_STT_COMPUTE_TYPE=default


# ── Chat interfaces ───────────────────────────────────────────────────────────

# Discord/Telegram/WhatsApp are *restricted* channels: conversation, Home
# Assistant queries and everyday device control only — no spawning, deleting,
# code, pipelines or admin commands. Each one needs a sender allow-list; without
# it the channel refuses to start, because a bot that answers strangers spends
# your LLM budget and controls your home. Comma-separate multiple entries.

# Discord — https://discord.com/developers/applications
#           enable "Message Content Intent" in the bot settings
#           user id: enable Developer Mode → right-click your name → Copy User ID
DISCORD_BOT_TOKEN=

# A Discord webhook for notifications, as an alternative to storing one with
# `/webhook discord <url>` in a conversation. Set here, the address is never
# quoted into a prompt and never written into generated code: the planner is
# told the variable's name and the code reads it at run time, so it stays out of
# anything a model sees or anything that persists. The same variable has to be
# set wherever that code ends up running: an agent migrated to a remote node
# reads the node's environment, not this one.
# DISCORD_WEBHOOK_URL=
DISCORD_ALLOWED_USER_IDS=

# Telegram — create a bot via @BotFather → /newbot
#             set the token, restart, then DM the bot /start to get your user id
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# WhatsApp via Twilio — the webhook is a public HTTP endpoint, so senders must
# be pinned (e.g. WHATSAPP_ALLOWED_NUMBERS=+306912345678)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
WHATSAPP_ALLOWED_NUMBERS=

# Max messages per minute per sender across the social channels (0 disables).
SOCIAL_RATE_LIMIT_PER_MIN=12


# ── Google agents: Calendar & Gmail ──────────────────────────────────────────
# Powers the `google-calendar-agent` and `gmail-agent` catalog agents.
# Full setup walkthrough: docs/google-agents.md
#
# One Google Cloud OAuth *Web application* client is shared by both agents.
# Add this exact redirect URI to it: http://localhost:8765/oauth/callback
# Enable the APIs you need in the project:
#   calendar-json.googleapis.com + calendarmcp.googleapis.com   (Calendar)
#   gmail.googleapis.com         + gmailmcp.googleapis.com      (Gmail)
# Leaving a section blank simply disables that agent. Never commit real values.

# Calendar
CALENDAR_MCP_CLIENT_ID=
CALENDAR_MCP_CLIENT_SECRET=
# URL, redirect and scopes have working defaults — override only if needed.
# CALENDAR_MCP_URL=https://calendarmcp.googleapis.com/mcp/v1
# CALENDAR_MCP_REDIRECT_URI=http://localhost:8765/oauth/callback
# CALENDAR_MCP_SCOPES=https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/calendar.readonly
# CALENDAR_MCP_TOKEN_FILE=          # default: ~/.wactorz/calendar_mcp_token.json
# CALENDAR_MCP_TIMEZONE=Europe/Athens   # falls back to TZ / system local zone

# Gmail  (draft-first — the agent never sends mail)
GMAIL_MCP_CLIENT_ID=
GMAIL_MCP_CLIENT_SECRET=
# GMAIL_MCP_URL=https://gmailmcp.googleapis.com/mcp/v1
# GMAIL_MCP_REDIRECT_URI=http://localhost:8765/oauth/callback
# Scopes deliberately exclude gmail.metadata (it blocks free-text search).
# GMAIL_MCP_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/gmail.labels
# GMAIL_MCP_TOKEN_FILE=             # default: ~/.wactorz/gmail_mcp_token.json

# Optional: seconds to wait on the hosted MCP before falling back to REST (default 20).
# GOOGLE_MCP_TIMEOUT=20
