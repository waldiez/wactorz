# Sinergym bridge image — Sinergym 3.12.0 on EnergyPlus 25.1.0.
#
# The base sailugr/sinergym:v3.12.0-lite already ships Sinergym 3.12.0 on
# EnergyPlus 25.1.0, so no from-source EnergyPlus build or version juggling is
# needed (unlike the older 3.11.0/EnergyPlus-24.1.0 combo, which had no matching
# published image). The *-lite* variant (~0.7 GB vs 13 GB) bundles Sinergym +
# EnergyPlus but omits the DRL stack (stable-baselines3 / torch): the bridge only
# drives the simulation and talks MQTT/Fuseki — all policy inference runs
# host-side in wactorz — so none of that weight is needed here.
#
# The base is published amd64-only. On arm64 hosts (e.g. Apple Silicon) build and
# run with `--platform=linux/amd64` (QEMU emulation) — passing the flag avoids the
# BuildKit "constant FROM --platform" lint; run-bridge.sh already passes it on run.
FROM sailugr/sinergym:v3.12.0-lite

# Pin Sinergym to 3.12.0 — a confirming no-op on a matching base, but explicit so
# the image stays reproducible if the base tag drifts. paho-mqtt is the bridge's
# only non-stdlib dep (Fuseki writes use stdlib urllib).
RUN pip install --no-cache-dir --force-reinstall --no-deps "sinergym==3.12.0" \
 && pip install --no-cache-dir "paho-mqtt>=2.0"

# Drop the 15-zone OfficeMedium building + its env config into the dirs Sinergym
# resolves building/config files from (path discovered at build time, not hardcoded).
COPY ASHRAE901_OfficeMedium_STD2019_Denver_MultiAgent.epJSON /tmp/bld.epJSON
COPY officeMedium_multiagent.yaml /tmp/cfg.yaml
RUN SGY="$(python -c 'import sinergym,os;print(os.path.dirname(sinergym.__file__))')" \
 && echo "sinergym data dir: $SGY/data" \
 && cp /tmp/bld.epJSON "$SGY/data/buildings/ASHRAE901_OfficeMedium_STD2019_Denver_MultiAgent.epJSON" \
 && cp /tmp/cfg.yaml   "$SGY/data/default_configuration/officeMedium_multiagent.yaml" \
 && rm -f /tmp/bld.epJSON /tmp/cfg.yaml \
 && python -c "import sinergym; print('sinergym', sinergym.__version__)" \
 && energyplus --version
