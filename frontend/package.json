{
  "name": "wactorz-dashboard",
  "version": "0.5.3",
  "description": "Wactorz dashboard",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "bun run typecheck && bun run prettier:check && bun run eslint:check && bun run markdownlint:check",
    "typecheck": "tsc --noEmit",
    "eslint:check": "eslint --config ./eslint.config.mjs --report-unused-disable-directives --max-warnings 0 --no-warn-ignored --cache .",
    "eslint": "eslint --config ./eslint.config.mjs --fix --cache .",
    "prettier:check": "prettier \"src/**/*{.ts,.tsx,.css,.json}\" \"public/**/*.js\" \"*.{ts,mjs}\" --check",
    "prettier": "prettier \"src/**/*{.ts,.tsx,.css,.json}\" \"public/**/*.js\" \"*.{ts,mjs}\" --write --list-different",
    "markdownlint:check": "markdownlint-cli2 \"*.md\"",
    "markdownlint": "markdownlint-cli2 --fix \"*.md\"",
    "fmt": "bun run prettier",
    "format": "bun run fmt",
    "docs": "typedoc --out ../site/api/js --entryPointStrategy expand src --name \"Wactorz JS\" --readme none --hideGenerator",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-headers": "^1.3.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "happy-dom": "^20.10.6",
    "markdownlint-cli2": "^0.23.0",
    "prettier": "^3.9.4",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
