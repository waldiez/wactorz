  "resources": [
    {
      "name": "agents_resource",
      "uri": "wactorz://agents",
      "description": "Current list of running agents as JSON.",
      "mimeType": "text/plain"
    },
    {
      "name": "capabilities_resource",
      "uri": "wactorz://capabilities",
      "description": "Full capability catalog (running + spawnable agents).",
      "mimeType": "text/plain"
    },
    {
      "name": "ha_map_resource",
      "uri": "wactorz://ha-map",
      "description": "Home Assistant entity + location map snapshot (from home-assistant-map-agent).",
      "mimeType": "text/plain"
    },
    {
      "name": "config_resource",
      "uri": "wactorz://config",
      "description": "MCP server configuration (sanitized \u2014 no tokens).",
      "mimeType": "text/plain"
    }
  ]
}
