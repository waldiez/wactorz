    {
      "name": "ha_call_service",
      "description": "Call a Home Assistant service (e.g. turn on a light, set thermostat).\n\nExamples:\n  ha_call_service(\"light\", \"turn_on\", \"light.kitchen\")\n  ha_call_service(\"light\", \"turn_on\", \"light.kitchen\", '{\"brightness\": 128}')\n  ha_call_service(\"climate\", \"set_temperature\", \"climate.bedroom\", '{\"temperature\": 20}')\n\ndata_json is a JSON string of extra service data (optional).\n",
      "inputSchema": {
        "properties": {
          "domain": {
            "title": "Domain",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "entity_id": {
            "default": "",
            "title": "Entity Id",
            "type": "string"
          },
          "data_json": {
            "default": "{}",
            "title": "Data Json",
            "type": "string"
          }
        },
