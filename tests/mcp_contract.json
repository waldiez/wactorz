{
  "tools": [
    {
      "name": "ask_wactorz",
      "description": "Send a message to the wactorz main orchestrator.\n\nThe orchestrator will route to an existing agent, spawn a new one, or\nanswer directly. Use for fuzzy requests (\"monitor my CPU temp\",\n\"what's the weather\") where you don't know which agent should handle it.\n",
      "inputSchema": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ask_wactorzArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "ask_wactorzOutput",
        "type": "object"
      }
    },
    {
      "name": "ask_agent",
      "description": "Send a message to a named agent and return that agent's reply.\n\nMain hands it straight to the agent, without deciding who should answer:\nit finds the agent running here, spawns it from the catalogue, or asks the\nnode it runs on. Use when you already know which agent should handle the\nrequest. Agent names are lowercase-hyphenated (e.g. \"home-assistant-agent\").\nRun list_agents() first if unsure.\n",
      "inputSchema": {
        "properties": {
          "agent_name": {
            "title": "Agent Name",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "agent_name",
          "message"
        ],
        "title": "ask_agentArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "ask_agentOutput",
        "type": "object"
      }
    },
